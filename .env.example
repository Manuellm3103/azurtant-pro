# ────────────────────────────────────────────────────────
# AzurTant PRO — Billing Server Config
# ────────────────────────────────────────────────────────

# Server
PORT=5194
PUBLIC_URL=http://localhost:5194

# ─── Stripe ──────────────────────────────────────────────
# Get test keys: https://dashboard.stripe.com/test/apikeys
# Get webhook secret: https://dashboard.stripe.com/test/webhooks
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Price IDs (crear en Stripe Dashboard)
STRIPE_PRICE_STARTER=price_starter_xxx
STRIPE_PRICE_PRO=price_pro_xxx
STRIPE_PRICE_ENTERPRISE=price_enterprise_xxx

# ─── MercadoPago ─────────────────────────────────────────
# Get credentials: https://www.mercadopago.com.mx/developers/panel
MP_ACCESS_TOKEN=APP_USR-xxxxxxxx-xxxxxx-xxxxxx
MP_PLAN_STARTER=
MP_PLAN_PRO=
MP_PLAN_ENTERPRISE=
